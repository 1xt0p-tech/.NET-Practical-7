<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Student Feedback Portal</title>
    <style>
        body {
            font-family: Segoe UI, Arial, sans-serif;
            margin: 0;
            background: #f4f6f8;
            color: #222;
        }

        header {
            background: #1f3a5f;
            color: #fff;
            padding: 14px 30px;
        }

            header h1 {
                margin: 0;
                font-size: 22px;
            }

        nav a {
            color: #cfe3ff;
            margin-right: 18px;
            text-decoration: none;
        }

            nav a:hover {
                text-decoration: underline;
            }

        main {
            max-width: 900px;
            margin: 24px auto;
            background: #fff;
            padding: 24px 30px;
            border-radius: 6px;
        }

        footer {
            text-align: center;
            color: #777;
            font-size: 13px;
            padding: 16px;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th, td {
            border: 1px solid #ccd;
            padding: 8px 10px;
            text-align: left;
        }

        th {
            background: #e8eef7;
        }

        .field-validation-error, .validation-summary-errors {
            color: #b00020;
        }

        .ok {
            background: #e6f4ea;
            padding: 8px 12px;
            border-left: 4px solid #2e7d32;
            margin-bottom: 14px;
        }
    </style>
</head>
<body>
    <header>
        <h1>Student Feedback Portal</h1>
        <nav>
            @Html.ActionLink("All Feedback", "Index", "Review")
            @Html.ActionLink("Submit Feedback", "Add", "Review")
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>&copy; @DateTime.Now.Year - Practical 7 - ASP.NET MVC</footer>

    @RenderSection("scripts", required: false)
</body>
</html>
